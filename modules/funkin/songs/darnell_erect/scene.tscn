[sub_resource type="GDScript" id="GDScript_g4v7s"]
script/source = "extends Node


@onready var bf_1: StrumlineManager = $bf_1
@onready var bf_2: StrumlineManager = $bf_2
@onready var bopeebo: AudioStreamPlayer2D = $bopeebo
@onready var evil_conductor: Conductor = $evil_conductor


func _ready() -> void:
	var evil_chart := Chart.load_chart(\"res://modules/funkin/songs/bopeebo\", &\"hard\")
	bf_1.load_notes(evil_chart.strumlines[&\"player\"].get(\"notes\"))
	bf_2.load_notes(evil_chart.strumlines[&\"opponent\"].get(\"notes\"))

	Game.instance.song_start.connect(_on_song_started)


func _on_song_started() -> void:
	bopeebo.play()
	evil_conductor.active = true
"

