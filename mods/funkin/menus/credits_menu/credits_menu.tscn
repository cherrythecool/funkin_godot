[sub_resource type="Shader" id="Shader_33ree"]
code = "shader_type canvas_item;

void vertex() {
	VERTEX.y += sin((TIME + VERTEX.y - VERTEX.x) * 16.0) * 4.0;
}

void fragment() {
	COLOR.r -= fract(UV.x - UV.y + TIME * 4.0);
}
"

